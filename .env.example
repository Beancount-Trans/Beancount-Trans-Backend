# ============================================================
# Beancount-Trans-Backend：本地开发用环境变量模板
#
# 用途：在开发者本机直接运行 Django / Celery（非主仓库 docker compose 自托管栈）。
# 自托管部署请使用主仓库（Beancount-Trans）根目录的 `.env.example`
#（与 `docker-compose.yaml` 同目录，由 compose `env_file` 注入容器）。
#
# 使用方法：cp .env.example .env 后按需修改；勿与主仓库自托管 .env 混用同一套互斥默认值。
# ============================================================

# ==================== Django 核心配置 ====================
DJANGO_SETTINGS_MODULE=project.settings.settings
# Django 密钥，生产环境必须修改为随机字符串
DJANGO_SECRET_KEY=your-secret-key-here-change-this

# 调试模式，生产环境必须设置为 False
DJANGO_DEBUG=True

# 生产环境需要明确配置允许的域名（逗号分隔）
# DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# CSRF 信任的来源（逗号分隔，需包含协议）
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ==================== PostgreSQL 数据库配置 ====================
TRANS_POSTGRESQL_DATABASE=beancount-trans
TRANS_POSTGRESQL_USER=postgres
TRANS_POSTGRESQL_PASSWORD=your-strong-password-here
TRANS_POSTGRESQL_HOST=127.0.0.1
TRANS_POSTGRESQL_PORT=5432

# ==================== Redis 配置 ====================
TRANS_REDIS_HOST=127.0.0.1
TRANS_REDIS_PORT=6379
TRANS_REDIS_PASSWORD=your-redis-password-here

# ==================== 存储配置 ====================
# 存储类型: minio / oss / s3
STORAGE_TYPE=minio

# --- MinIO 配置 (默认) ---
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=beancount-trans
MINIO_USE_HTTPS=False

# --- 阿里云 OSS 配置 (可选，当 STORAGE_TYPE=oss 时) ---
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_BUCKET_NAME=beancount-trans
# OSS_REGION=cn-hangzhou

# --- AWS S3 配置 (可选，当 STORAGE_TYPE=s3 时) ---
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET_NAME=beancount-trans
# S3_REGION=us-east-1
# S3_USE_SSL=True
# S3_VERIFY_SSL=True

# ==================== CORS 跨域配置 ====================
# 允许的跨域来源（逗号分隔，包含协议和端口）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==================== JWT 令牌配置 ====================
# JWT 访问令牌有效期（小时）
JWT_ACCESS_TOKEN_HOURS=72
# JWT 刷新令牌有效期（天），同时是滑动续期窗口：每次刷新都会重置为 N 天
JWT_REFRESH_TOKEN_DAYS=30

# ==================== Traefik/Fava 容器配置 ====================
# TRAEFIK_NETWORK=shared-network
# FAVA_IMAGE=dhr2333/beancount-trans-assets:latest
# BASE_URL=localhost
# CERTRESOLVER=myresolver

# ==================== Assets 文件路径 ====================
# 宿主机上 Assets 目录的绝对路径（用于 Docker 挂载）
ASSETS_HOST_PATH=/path/to/your/Assets

# ==================== OAuth 第三方登录配置 (可选) ====================
# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==================== 阿里云短信服务配置 (可选) ====================
# 用于手机号验证码登录功能。如果不配置，系统将使用模拟模式（开发环境可用）
# 生产环境需要配置真实的阿里云短信服务
# ALIYUN_SMS_ACCESS_KEY_ID=your-access-key-id
# ALIYUN_SMS_ACCESS_KEY_SECRET=your-access-key-secret
# ALIYUN_SMS_SIGN_NAME=your-sign-name
# ALIYUN_SMS_TEMPLATE_CODE=SMS_123456789

# ==================== 邮箱服务器配置 (可选) ====================
DEFAULT_FROM_EMAIL=your@qq.com
EMAIL_BIND_SUBJECT=邮箱绑定验证码
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_HOST_USER=your@qq.com
EMAIL_HOST_PASSWORD=your_qq_smtp_auth_code
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
EMAIL_TIMEOUT=15
EMAIL_CODE_EXPIRE_SECONDS=300
EMAIL_CODE_RESEND_INTERVAL=60

# ==================== Gitea 配置 (可选) ====================
GITEA_BASE_URL=https://your-gitea.cn
GITEA_ADMIN_TOKEN=your-gitea-admin-token
GITEA_ORG_NAME=beancount-trans
GITEA_WEBHOOK_SECRET=your-webhook-secret  # 随机生成，使用 openssl rand -hex 32 或 python3 -c "import secrets; print(secrets.token_hex(32))"
GIT_REPO_SIZE_LIMIT=20971520

# ==================== GitHub 配置 (可选) ====================
GITHUB_TOKEN=your-github-token

# ==================== AI 账本助手 (可选) ====================
# 平台级 DeepSeek API Key；Copilot 未填 BYOK 时回退使用，账单解析默认也使用它
# ASSISTANT_DEEPSEEK_API_KEY=sk-...
# ASSISTANT_BASE_URL=https://api.deepseek.com
# ASSISTANT_MODEL=deepseek-v4-flash
# 账单解析调用平台 LLM 的单次超时（秒），失败时回退本地 BERT
# PARSE_LLM_TIMEOUT=15
# 单次 BQL 返回最大行数，默认 100
# ASSISTANT_MAX_BQL_ROWS=100
# 单轮对话内 run_bql 最大调用次数，默认 5
# ASSISTANT_MAX_BQL_RUNS=5
# 单轮对话内 LLM 工具调用轮次上限（含 get_ledger_context / run_bql），默认 8
# ASSISTANT_MAX_TOOL_ROUNDS=8
# SSE 订阅最长等待时间（秒），默认 960（16 分钟），覆盖长任务生成
# ASSISTANT_STREAM_MAX_WAIT_SECONDS=960
# SSE 心跳间隔（秒），默认 30；需小于 Nginx 超时与客户端空闲超时
# ASSISTANT_STREAM_HEARTBEAT_SECONDS=30

# ==================== 用量计量 (可选) ====================
# 是否记录用量事件（解析 / BQL / LLM token）与每日存储快照，默认 true
# 关闭后不写任何用量数据，业务功能不受影响
# USAGE_METERING_ENABLED=true
# 用量明细建议保留天数，默认 400（覆盖季度订阅 + 年度统计）
# USAGE_EVENT_RETENTION_DAYS=400